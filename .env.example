# Countersign environment variables. Copy to .env.local and fill in.
# Non-negotiable #6: secrets live ONLY in .env.local (gitignored), never here, never committed.

# --- Agent (Vercel AI SDK v6 + Anthropic) ---
# Anthropic API key used by the AP agent and the quarantined classifier.
ANTHROPIC_API_KEY=
# Model id for the accounts-payable agent. temperature is fixed at 0 in code.
AGENT_MODEL=claude-haiku-4-5-20251001
# Model id for the quarantined fraud-likelihood classifier signal (classifier_flag).
CLASSIFIER_MODEL=claude-haiku-4-5-20251001

# --- Auth0 (Universal Login + CIBA async authorization) ---
# Your Auth0 tenant domain, e.g. your-tenant.us.auth0.com
AUTH0_DOMAIN=
# Regular Web App client id used for Universal Login.
AUTH0_CLIENT_ID=
# Regular Web App client secret. Also used as the CIBA (bc-authorize) client.
AUTH0_CLIENT_SECRET=
# Random 32+ byte secret used by @auth0/nextjs-auth0 to encrypt the session cookie.
AUTH0_SECRET=
# Base URL of this app, used for Auth0 callback URLs.
APP_BASE_URL=http://localhost:3000
# Identifier of the Auth0 API that exposes the payments:approve scope.
AUTH0_AUDIENCE=
# Auth0 user `sub` of the approver, used by CLI scripts (login_hint for CIBA) instead of a browser session.
APPROVER_SUB=

# --- Tiger Data (Tiger Cloud / TimescaleDB) ---
# postgres:// connection string for the Tiger Cloud service, via the `postgres` package.
DATABASE_URL=

# --- Solana (devnet only — see non-negotiable #5) ---
# Must be a devnet RPC endpoint. scripts/doctor.ts refuses to proceed if this contains "mainnet".
SOLANA_RPC_URL=https://api.devnet.solana.com
# SPL mint address for the mock USDC (mUSDC) token, 6 decimals. Set by scripts/chain-setup.ts.
MUSDC_MINT=
# Base58 secret key for the treasury wallet (fee payer + mint authority). ONLY read by src/lib/solana/signer.ts.
TREASURY_SECRET_KEY=
# Base58 secret keys for the three verified demo vendors, generated by scripts/chain-setup.ts.
VENDOR_BLUERIDGE_SECRET_KEY=
VENDOR_CHESAPEAKE_SECRET_KEY=
VENDOR_COLONIAL_SECRET_KEY=
# Base58 secret keys for the two attacker wallets used in the demo scenarios.
ATTACKER_A_SECRET_KEY=
ATTACKER_B_SECRET_KEY=

# --- Demo ---
# Enables demo-only routes like POST /api/demo/reset.
DEMO_MODE=true
